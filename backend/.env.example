# Copy this file to .env and fill in your values
# Required for AI features
GEMINI_API_KEY=your_gemini_api_key_here

# Auto-generated by Render, but can be set manually
SECRET_KEY=your_secret_key_here

# Leave as default for SQLite, or use a PostgreSQL URL for production
DATABASE_URL=sqlite:///skillgap.db

FLASK_ENV=production

# Your deployed Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://your-skillgapai.vercel.app
